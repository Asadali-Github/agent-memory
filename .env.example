# Copy to .env and fill in. NEVER commit .env (it's gitignored).

# University HPC (primary): OpenAI-compatible server, e.g. vLLM:
#   vllm serve meta-llama/Llama-3.1-8B-Instruct --port 8000
HPC_BASE_URL=http://localhost:8000/v1
HPC_API_KEY=

# Hosted fallbacks
GROQ_API_KEY=
OPENROUTER_API_KEY=

# hard spend cap in GBP — client kill-switch halts all runs at this value
BUDGET_GBP_CAP=30
